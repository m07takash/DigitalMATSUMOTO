USER_FOLDER: "user/"
SESSION_FOLDER_PREFIX: "session"
SESSION_FILE_NAME: "chat_memory.json"
SESSION_STATUS_FILE_NAME: "status.yaml"
SESSION_CONTENTS_FOLDER: "contents/"
SESSION_ANALYTICS_FOLDER: "analytics/"
# Chat-history storage backend. See README §Chat history storage backends.
#   JSON        — one chat_memory.json per session under user/<prefix><id>/ (default)
#   PostgreSQL  — writes each turn to the digim_chat_history table (JSONB payload).
#                 Requires POSTGRES_HOST / POSTGRES_PORT / POSTGRES_DB / POSTGRES_USER /
#                 POSTGRES_PASSWORD env vars (system.env). Optional POSTGRES_SSLMODE.
#                 Table + indexes are auto-created on first write.
#   CosmosDB    — writes each turn as a document to a Cosmos SQL API container.
#                 Requires COSMOS_ENDPOINT / COSMOS_KEY env vars (system.env).
#                 COSMOS_DATABASE / COSMOS_CONTAINER default to digimatsu / chat_history.
#                 Container must exist beforehand with partition key /session_id.
# Non-chat-history side data (status.yaml / vec/*.npy / contents/ / analytics/)
# always remains on disk under user/<prefix><id>/ regardless of this setting.
# Existing on-disk sessions keep being read/written as JSON — the backend
# choice only applies to newly-created sessions after switching.
SESSION_STORE_METHOD: "JSON"
# CosmosDB defaults (only used when SESSION_STORE_METHOD=CosmosDB)
COSMOS_DATABASE: "digimatsu"
COSMOS_CONTAINER: "chat_history"
ARCHIVE_FOLDER: "user/archive/"
ARCHIVE_DAYS: 30
AGENT_FOLDER: "user/common/agent/"
CHARACTER_FOLDER: "user/common/agent/character/"
PRACTICE_FOLDER: "user/common/practice/"
TOOL_FOLDER: "user/common/tool/"
MST_FOLDER: "user/common/mst/"
RAG_FOLDER_DB: "user/common/rag/chromadb/"
RAG_FOLDER_PAGES: "user/common/rag/pages/"
RAG_FOLDER_GRAPH: "user/common/rag/graph/"
RAG_DATA_CSV_FOLDER: "user/common/csv/"
USER_MEMORY_FOLDER: "user/common/user_memory/"
TEMP_FOLDER: "user/common/temp/"
TEST_FOLDER: "test/"
# NOTE: scheduled-job settings have been migrated to user/common/mst/scheduled_jobs.json.
# Edit them from the Scheduler menu in the WebUI.
# Maximum number of agent personas to run in parallel (ThreadPoolExecutor max_workers
# when sending to multiple personas simultaneously)
MAX_PARALLEL_PERSONAS: 4
# Maximum number of personas auto-selected in Thinking Mode (default for the WebUI "Max Personas" input)
MAX_PERSONAS: 3
# Default web-search engine. Must be one of the keys in WEB_SEARCH_ENGINES_AVAILABLE.
WEB_SEARCH_DEFAULT: "OpenAI"
# Which engines appear in the WebUI dropdown. Comment out or remove entries
# to hide them from the picker (the underlying function still exists; this
# only controls the UI surface). Leave empty/missing to expose all.
WEB_SEARCH_ENGINES_AVAILABLE:
  - "Perplexity"
  - "OpenAI"
#  - "AzureOpenAI"
# Amazon Bedrock hosted Web Search. Needs AWS_BEARER_TOKEN_BEDROCK and the
# bedrock-websearch IAM actions; uncomment once those are in place.
#  - "Bedrock"
  - "Google"
  - "Claude"
PERPLEXITY_URL: "https://api.perplexity.ai/chat/completions"
PERPLEXITY_MODEL: "sonar"
PERPLEXITY_SYSTEM_PROMPT: "Be precise and concise."
PERPLEXITY_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
PERPLEXITY_MAX_TOKENS: 2000
PERPLEXITY_REASONING_EFFORT: "medium"
OPENAI_SEARCH_MODEL: "gpt-5.4-mini"
OPENAI_SEARCH_SYSTEM_PROMPT: "Be precise and concise."
OPENAI_SEARCH_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
# Azure OpenAI Service — uses AZURE_OPENAI_API_KEY / AZURE_OPENAI_ENDPOINT /
# AZURE_OPENAI_API_VERSION env vars (same convention as the rest of the app).
# AZURE_OPENAI_SEARCH_MODEL is the *deployment name* (not the base model id).
AZURE_OPENAI_SEARCH_MODEL: "gpt-5.4-mini"
AZURE_OPENAI_SEARCH_SYSTEM_PROMPT: "Be precise and concise."
AZURE_OPENAI_SEARCH_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
# Amazon Bedrock hosted Web Search — uses AWS_BEARER_TOKEN_BEDROCK (or
# BEDROCK_API_KEY) and BEDROCK_SEARCH_REGION / BEDROCK_REGION env vars.
# Server-side tools run on the bedrock-mantle endpoint only, so this engine
# ignores BEDROCK_ENDPOINT. BEDROCK_SEARCH_MODEL is a Bedrock model id
# (not an inference profile), and Web Search needs GPT-5.4 or later.
BEDROCK_SEARCH_MODEL: "openai.gpt-5.6-terra"
BEDROCK_SEARCH_SYSTEM_PROMPT: "Be precise and concise."
BEDROCK_SEARCH_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
# Observation budget per Search call: low (5) / medium (11) / high (25).
BEDROCK_SEARCH_CONTEXT_SIZE: "medium"
# false keeps retrieval inside the AWS boundary (Amazon's web index + cache).
# true additionally fetches live pages, which requires the IAM action
# bedrock-websearch:ExternalWebAccess and lets the query reach the open web.
BEDROCK_SEARCH_EXTERNAL_WEB_ACCESS: false
# Optional: restrict results to these domains (max 100; subdomains included).
BEDROCK_SEARCH_ALLOWED_DOMAINS: []
# Optional: override the full base URL when a model is served under /v1
# instead of /openai/v1 on bedrock-mantle (the model card states which).
#BEDROCK_SEARCH_BASE_URL: "https://bedrock-mantle.us-west-2.api.aws/v1"
GOOGLE_SEARCH_MODEL: "gemini-3.5-flash"
GOOGLE_SEARCH_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
CLAUDE_SEARCH_MODEL: "claude-opus-4-8"
CLAUDE_SEARCH_SYSTEM_PROMPT: "Be precise and concise."
CLAUDE_SEARCH_USER_PROMPT: "以下の入力に基づいて、関連する情報を提供してください。"
CLAUDE_SEARCH_MAX_TOKENS: 4096
URL_FETCH:
  TIMEOUT: 10
  MAX_BYTES: 2097152
  MAX_SUBPAGES: 5
  MAX_DEPTH: 1
  USER_AGENT: "DigiMatsuAgent/1.0 (+URL fetch)"
  # Extra domains to deny (subdomains are denied recursively)
  BLOCKED_DOMAINS: []
  # When non-empty, switches to whitelist mode (only listed domains are allowed)
  ALLOWED_DOMAINS: []
  # Path to an external blocklist in hosts format (`0.0.0.0 example.com`) or one-domain-per-line
  # Recommended public lists:
  #   - StevenBlack/hosts (adult + gambling + malware etc.): https://github.com/StevenBlack/hosts
  #   - UT1 blacklists (by category: adult / malware / phishing / warez, etc.): https://dsi.ut-capitole.fr/blacklists/
  #   - Hagezi DNS blocklists: https://github.com/hagezi/dns-blocklists
  # Example: BLOCKLIST_FILE: "user/common/mst/blocklist_hosts.txt"
  BLOCKLIST_FILE: ""
  BLOCKED_EXTENSIONS:
    - ".exe"
    - ".bat"
    - ".cmd"
    - ".msi"
    - ".scr"
    - ".dll"
    - ".vbs"
    - ".ps1"
    - ".jar"
    - ".apk"
    - ".dmg"